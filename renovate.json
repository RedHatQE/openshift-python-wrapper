{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    ":dependencyDashboard",
    ":maintainLockFilesWeekly",
    ":prHourlyLimitNone",
    ":semanticCommitTypeAll(ci )"
  ],
  "prConcurrentLimit": 0,
  "lockFileMaintenance": {
    "enabled": true
  },
  "baseBranches": ["main", "v4.20", "v4.21", "v4.22"],
  "ignoreDeps": ["kubernetes"],
  "packageRules": [
    {
      "matchManagers": ["pep621"],
      "matchDepTypes": ["requires-python"],
      "enabled": false
    },
    {
      "baseBranchList": ["v4.20", "v4.21", "v4.22"],
      "enabled": false
    },
    {
      "matchPackagePatterns": ["*"],
      "groupName": "python-dependencies"
    }
  ]
}
